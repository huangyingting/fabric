    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.511.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.5"
