# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./prisma/dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://fabric:fabric@localhost:5432/fabric?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="fabric-super-secret-dev-key-change-in-production-2025"

# Invite-Only Account Admission Mode ("invitation-only" | "open")
ACCOUNT_ADMISSION_MODE="invitation-only"

# Bootstrap Admin Credentials (used by `npm run bootstrap:admin`)
BOOTSTRAP_ADMIN_EMAIL="admin@fabric.local"
BOOTSTRAP_ADMIN_PASSWORD="AdminPassword123!"
BOOTSTRAP_ADMIN_NAME="Joshuah Powlowski"

# Pluggable AI Capability ("copilot-sdk" | "azure-openai")
AI_PROVIDER="copilot-sdk"
COPILOT_MODEL="gpt-5.6-sol"

# Azure OpenAI Configuration (used when AI_PROVIDER="azure-openai")
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-10-21"
